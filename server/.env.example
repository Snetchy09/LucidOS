# Backblaze B2 S3-compatible storage
B2_REGION=us-west-000
B2_BUCKET_NAME=your-bucket
B2_APPLICATION_KEY_ID=your-key-id
B2_APPLICATION_KEY=your-application-key

# Public URL is optional. Leave empty when downloads should stay private.
B2_PUBLIC_BASE_URL=

# Supabase Auth validation
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-publishable-key

# URL allowed to call this service
LUCID_ORIGIN=https://snetchy09.github.io

# Subscribed users can use this larger limit. Change it to match your plan.
B2_PRO_MAX_APP_BYTES=1073741824
